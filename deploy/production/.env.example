# Copy to a secret-managed environment file; never commit real values.
AURELIX_DOMAIN=aurelix.example.com
AURELIX_OWNER_ID=owner
AURELIX_OWNER_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-password

AURELIX_MODEL_BASE_URL=https://api.openai.com/v1
AURELIX_MODEL_NAME=gpt-4o-mini
AURELIX_MODEL_API_KEY=replace-with-provider-key
AURELIX_RESEARCH_API_KEY=replace-with-tavily-key
AURELIX_LOG_LEVEL=INFO
