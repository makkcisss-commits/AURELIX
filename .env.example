# AURELIX runtime configuration template
# Never place real credentials in this file.

AURELIX_ENV=development
AURELIX_LOG_LEVEL=INFO
AURELIX_OWNER_ID=owner-local-placeholder
AURELIX_API_BASE_URL=http://localhost:8000
AURELIX_DATABASE_PATH=data/aurelix.db

# OpenAI-compatible model endpoint (can point to a self-hosted gateway).
AURELIX_MODEL_BASE_URL=https://api.openai.com/v1
AURELIX_MODEL_NAME=
# MODEL_PROVIDER_API_KEY=

# Search/research provider: an HTTPS JSON endpoint that accepts {"query": ...}
# and returns {"results": [{"source":...,"claim":...,"confidence":...,"verified":...}]}
AURELIX_RESEARCH_URL=
# AURELIX_RESEARCH_API_KEY=

# Keep production credentials in a deployment secret manager, never in Git.
# DATABASE_URL=
# SESSION_SECRET=
