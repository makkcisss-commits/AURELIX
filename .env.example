# AURELIX runtime configuration template
# Never place real credentials in this file.

AURELIX_ENV=development
AURELIX_LOG_LEVEL=INFO
AURELIX_HOST=0.0.0.0
AURELIX_PORT=8000
AURELIX_OWNER_ID=owner-local-placeholder
AURELIX_OWNER_SECRET=replace-with-a-long-random-secret

# Optional OpenAI-compatible model endpoint. Leave unset for read-only/local UI mode.
AURELIX_MODEL_BASE_URL=https://api.openai.com/v1
AURELIX_MODEL_NAME=gpt-4o-mini
AURELIX_MODEL_API_KEY=

# Research provider: http or tavily. Leave unset for local UI mode.
AURELIX_RESEARCH_PROVIDER=http
AURELIX_RESEARCH_URL=
AURELIX_RESEARCH_API_KEY=

# Optional PostgreSQL knowledge backend. Without this, AURELIX uses SQLite runtime state
# plus the in-memory knowledge repository.
AURELIX_DATABASE_URL=

# Keep production credentials in a deployment secret manager, never in Git.
